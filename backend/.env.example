APP_PORT=3009
APP_SECRETKEY=change_me_to_a_random_secret
APP_ACCESS_TOKEN_TTL=6h
APP_REFRESH_TOKEN_TTL=168h
# Set to true once served over HTTPS, otherwise the browser drops the refresh cookie
APP_COOKIE_SECURE=false

# PostgreSQL is not containerized - install it on the host and fill in the
# credentials below. When running via docker-compose, DB_HOST is overridden
# to host.docker.internal automatically; this DB_HOST value is only used for
# `go run` / non-Docker runs.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=phorpug

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3009

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@horpug.local
ADMIN_PASSWORD=change_me_strong_password
