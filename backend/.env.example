APP_PORT=3009
APP_SECRETKEY=change_me_to_a_random_secret
APP_ACCESS_TOKEN_TTL=6h
APP_REFRESH_TOKEN_TTL=168h
# Set to true once served over HTTPS, otherwise the browser drops the refresh cookie
APP_COOKIE_SECURE=false

# DB_HOST is only used for `go run` / non-Docker runs; when running via
# docker-compose, DB_HOST is overridden to the `postgres` service name
# automatically (see docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=phorpug

# Mirrors of DB_USERNAME/DB_PASSWORD/DB_NAME above, read directly by the
# `postgres` container in docker-compose.yml (the official postgres image
# only recognizes these exact names). Keep the values identical to DB_*.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=phorpug

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3009

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@horpug.local
ADMIN_PASSWORD=change_me_strong_password
