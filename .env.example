# Copy this file to .env (project root) and fill in your values
# .env must NOT be committed to git
#
# Note: the database is not containerized - install PostgreSQL directly on
# the host and configure DB_HOST/DB_USERNAME/DB_PASSWORD/DB_NAME in
# backend/.env instead (docker-compose.yml points the backend container at
# host.docker.internal to reach it).

# CORS allowed origins (use https:// once the site is reached over HTTPS)
CORS_ORIGINS=http://localhost

# CN/SAN for nginx's self-signed HTTPS cert (nginx/generate-cert.sh).
# Set this to the server's public IP for now; switch to the real domain
# name once one exists, and eventually replace the self-signed cert with
# a Let's Encrypt one.
SSL_CN=localhost
