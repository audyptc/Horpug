# Copy to .env for local development.
# URL of the backend API used by the dev server proxy (see vite.config.ts).
# Leave empty in production builds — nginx proxies /api to the backend on the
# same origin (see ../frontend/Dockerfile and ../nginx/nginx.conf).
VITE_API_URL=http://localhost:3009

# LIFF app ID for the tenant LINE-linking page (frontend/src/features/line).
# Register the LIFF app under a LINE Login channel (LINE no longer allows
# attaching one to a Messaging API channel) that lives in the SAME provider as
# the Messaging API channel — LINE userIds are only consistent within a
# provider, so a mismatch makes every pushed invoice fail. Use endpoint URL
# https://<your-domain>/liff/link-tenant, the "openid" scope (needed for
# liff.getIDToken()) and size "Full" (needed for liff.requestFriendship()).
# The LIFF ID is "<channel id>-<suffix>", and its channel id must match the
# backend's LINE_CHANNEL_ID. This value is public (embedded in the frontend
# bundle), unlike the backend's channel access token.
VITE_LIFF_ID=
