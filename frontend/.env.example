# Copy to .env for local development.
# URL of the backend API used by the dev server proxy (see vite.config.ts).
# Leave empty in production builds — nginx proxies /api to the backend on the
# same origin (see ../frontend/Dockerfile and ../nginx/nginx.conf).
VITE_API_URL=http://localhost:3009

# LIFF app ID for the tenant LINE-linking page (frontend/src/features/line).
# Register a LIFF app under the Messaging API channel in LINE Developers
# Console, with endpoint URL https://<your-domain>/liff/link-tenant and the
# "openid" scope enabled (needed for liff.getIDToken()). This value is public
# (embedded in the frontend bundle), unlike the backend's channel secret.
VITE_LIFF_ID=
