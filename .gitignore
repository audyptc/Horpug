# Environment variables
# สำคัญมาก: ห้ามเอาไฟล์ที่มี Password หรือ Secret ขึ้น GitHub
.env
.env.*
!.env.example
!.env.production
!.env.development

# Binary builds
# สร้างไฟล์ executable จากคำสั่ง go build
*.exe
/backend/app

# Logs
logs
*.log
*.lock
!package-lock.json

# Node dependencies
node_modules

# claude
.claude

# TLS cert/key placed on the VPS (Cloudflare Origin CA or Let's Encrypt) —
# never commit private key material. See nginx/generate-cert.sh.
nginx/certs/*
!nginx/certs/.gitkeep